<?xml version="1.0"?>
<!--
	PHP_CodeSniffer ruleset for the Layar Katalog theme and core plugin.

	Run it with:  phpcs -&#45;standard=phpcs.xml.dist .

	The CI job that uses this ruleset compares the revision against its base and
	fails only on violations the change introduces, so the debt in files that
	predate the ruleset does not make every pull request red. Pass -&#45;detail to
	tests/phpcs-regression.mjs to see the new ones with file:line:column.
-->
<ruleset name="Layar Katalog">
	<description>WordPress coding standards for the Layar Katalog block theme and its companion plugin.</description>

	<file>plugins/layar-katalog-core</file>
	<file>themes/layar-katalog</file>
	<file>child-theme</file>

	<!-- Bundled Composer dependencies follow their own upstream standards. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<!--
		The PHP test harness is not shipped code and is written in a deliberately
		compact style: it stubs WordPress primitives as one-liners, evaluates
		extracted source, and carries hostile strings as fixtures. Scanning it with
		WordPress-Docs and the brace and spacing rules produced 491 violations that
		said nothing about the theme or the plugin, so it is out of scope here and
		out of the file list the CI job scans. Everything under plugins/, themes/
		and child-theme/ stays fully in scope.
	-->
	<exclude-pattern>*/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_supported_wp_version" value="6.3"/>
	<config name="testVersion" value="8.2-"/>

	<rule ref="WordPress">
		<!--
			The plugin's main file is named after the plugin slug and the theme
			files follow the block-theme layout, neither of which matches the
			class-file naming convention this sniff expects.
		-->
		<exclude name="WordPress.Files.FileName"/>

		<!--
			Nonce and capability checks in this project are handled by explicit
			check_admin_referer()/current_user_can() calls at the top of each
			handler, which the sniff does not always recognise through helpers.
		-->
		<exclude name="WordPress.Security.NonceVerification.Missing"/>
	</rule>

</ruleset>
