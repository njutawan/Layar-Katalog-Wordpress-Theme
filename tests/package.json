{
	"name": "layar-katalog-tests",
	"version": "1.0.0",
	"private": true,
	"description": "Test harnesses for the Layar Katalog theme and core plugin. Not shipped to end users.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"lint:js": "node lint-js.mjs",
		"lint:php": "node php/lint-phpwasm.mjs 8.2",
		"test:sw": "node js/service-worker.test.js",
		"test:sw:baseline": "node js/service-worker.test.js --previous",
		"test:standards": "node js/phpcs-regression.test.js",
		"test:wp:guards": "bash wp/guards.test.sh",
		"test:player": "node js/player-dom-xss.test.js",
		"test:player:baseline": "node js/player-dom-xss.test.js --previous",
		"test:php": "php php/security.test.php",
		"test:php:wasm": "node php/run-phpwasm.mjs 8.2",
		"test": "npm run lint:js && npm run test:standards && npm run test:sw && npm run test:player && npm run test:php:wasm"
	},
	"devDependencies": {
		"@php-wasm/node": "^3.1.54",
		"@php-wasm/universal": "^3.1.54",
		"jsdom": "^26.1.0"
	}
}
