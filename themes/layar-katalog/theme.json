{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "740px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "base", "color": "#f4f5ef", "name": "Kertas" },
        { "slug": "surface", "color": "#fffefa", "name": "Putih Hangat" },
        { "slug": "contrast", "color": "#19342d", "name": "Hijau Tinta" },
        { "slug": "primary", "color": "#ccf36b", "name": "Lime" },
        { "slug": "secondary", "color": "#fa765d", "name": "Koral" },
        { "slug": "muted", "color": "#718078", "name": "Hijau Kelabu" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "slug": "system", "name": "System Sans" },
        { "fontFamily": "Georgia, 'Times New Roman', serif", "slug": "editorial", "name": "Editorial Serif" }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.82rem", "name": "Kecil" },
        { "slug": "medium", "size": "1rem", "name": "Normal" },
        { "slug": "large", "size": "1.35rem", "name": "Besar" },
        { "slug": "x-large", "size": "clamp(2.2rem, 5vw, 4rem)", "name": "Sangat Besar" }
      ],
      "lineHeight": true,
      "letterSpacing": true
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "10", "size": "0.5rem", "name": "1" },
        { "slug": "20", "size": "0.75rem", "name": "2" },
        { "slug": "30", "size": "1rem", "name": "3" },
        { "slug": "40", "size": "1.5rem", "name": "4" },
        { "slug": "50", "size": "2rem", "name": "5" },
        { "slug": "60", "size": "3rem", "name": "6" },
        { "slug": "70", "size": "4rem", "name": "7" }
      ],
      "padding": true,
      "margin": true
    },
    "custom": {
      "radius": {
        "small": "10px",
        "medium": "18px",
        "large": "28px",
        "pill": "999px"
      }
    },
    "blocks": {
      "core/button": { "border": { "radius": true } },
      "core/image": { "border": { "radius": true } },
      "core/post-featured-image": { "border": { "radius": true } }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "1rem",
      "lineHeight": "1.65"
    },
    "spacing": { "blockGap": "1.5rem" },
    "elements": {
      "link": {
        "color": { "text": "currentColor" },
        "typography": { "textDecoration": "none" }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|editorial",
          "fontWeight": "600",
          "letterSpacing": "-0.045em",
          "lineHeight": "1.1"
        }
      },
      "button": {
        "border": { "radius": "999px" },
        "typography": { "fontWeight": "700" }
      }
    },
    "blocks": {
      "core/post-title": { "typography": { "fontWeight": "600", "lineHeight": "1.15" } },
      "core/navigation-link": { "typography": { "fontSize": "0.9rem" } }
    }
  }
}
